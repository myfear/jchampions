# Build the application: ./mvnw package
# Build the image: podman build -f src/main/docker/Dockerfile.jvm -t speaker-cards-jvm .
# Run the image with PostgreSQL connection settings supplied through QUARKUS_DATASOURCE_*.
# Publish matching HTTP ports (for example, -p 8080:8080) so rendering can fetch its assets.
# Set JAVA_TOOL_OPTIONS to supply additional JVM options.
FROM ibm-semeru-runtimes:open-27.0.0.0-jre-noble

WORKDIR /deployments
RUN chown 185:0 /deployments
COPY --chown=185:0 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185:0 target/quarkus-app/*.jar /deployments/
COPY --chown=185:0 target/quarkus-app/app/ /deployments/app/
COPY --chown=185:0 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185:0
ENV QUARKUS_HTTP_HOST=0.0.0.0

ENTRYPOINT ["java", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/deployments/quarkus-run.jar"]
